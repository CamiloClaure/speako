# Copy to .env for local development. Never commit the filled version.
# Parsed once at boot into internal/config; a missing required value must abort startup.

SPEAKO_ENV=development                  # development | production
SPEAKO_ADDR=:8080
SPEAKO_DB_PATH=./speako.dev.db
SPEAKO_PUBLIC_URL=http://localhost:5173 # SPA origin, used for CORS and payment back_urls
SPEAKO_API_URL=http://localhost:8080

# Session cookies
SPEAKO_SESSION_SECRET=                  # 32+ random bytes, base64. openssl rand -base64 32
SPEAKO_SESSION_TTL_HOURS=720

# Teacher (single-teacher MVP)
SPEAKO_TEACHER_EMAIL=
SPEAKO_TEACHER_TIMEZONE=America/Sao_Paulo
SPEAKO_MEETING_URL=                     # fixed Meet/Zoom room attached to every booking

# Booking policy (hours)
SPEAKO_MIN_NOTICE_HOURS=12
SPEAKO_FREE_CANCEL_HOURS=24

# Mercado Pago (Checkout Pro)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Cloudflare R2 (S3-compatible, materials storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=speako-materials

# Resend (transactional email)
RESEND_API_KEY=
SPEAKO_MAIL_FROM="Speako <ola@speako.com.br>"

# Google sign-in
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=              # same client ID, exposed to the SPA build; button is hidden when empty
